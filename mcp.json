{
  "mcpServers": {
    "cotlet": {
      "url": "https://cotlet.dev/mcp/v1",
      "headers": {
        "Authorization": "Bearer ${COTLET_API_KEY}"
      }
    },
    "square-appointments": {
      "command": "python3",
      "args": [
        "/absolute/path/to/square-appointments-mcp/square_appointments_agent.py"
      ],
      "env": {
        "COTLET_API_KEY": "${COTLET_API_KEY}"
      }
    }
  }
}
